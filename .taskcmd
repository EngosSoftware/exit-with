.note These task definitions require TaskCommander.
      Install it using cargo:
      `cargo install task-commander`

.vars
  .RUST_TOOLCHAIN +1.88.0

.tasks

  .all
    .task clean
    .task build
    .task clippy
    .task pedantic
    .task test
    .task doc
    .task cov

  .build
    .desc Builds in debug mode
    .cmd cargo {{RUST_TOOLCHAIN}} build

  .clean
    .desc Cleans all
    .cmd rm -rf manual/book
    .cmd cargo {{RUST_TOOLCHAIN}} clean

  .clippy
    .desc Runs linter
    .cmd cargo {{RUST_TOOLCHAIN}} clippy --all-targets -- -D warnings

  .cov
    .desc Generates code coverage report in text format
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov clean
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov --no-cfg-coverage

  .cov-html
    .desc Generates code coverage report in HTML format
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov clean
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov --no-cfg-coverage --html

  .cov-html-open
    .desc Generates code coverage report in HTML format and opens in browser
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov clean
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov --no-cfg-coverage --html --open

  .cov-badge
    .desc Generates code coverage badge
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov clean
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov --no-cfg-coverage --json --summary-only | coverio -l coverage -c --tag cov-badge

  .doc
    .desc Generates documentation
    .cmd cargo {{RUST_TOOLCHAIN}} doc --no-deps

  .doc-open
    .desc Generates documentation and opens in browser
    .cmd cargo {{RUST_TOOLCHAIN}} doc --no-deps --open

  .fmt
    .desc Runs code formatter
    .cmd cargo {{RUST_TOOLCHAIN}} fmt

  .install
    .desc Installs binary built from local sources
    .cmd cargo {{RUST_TOOLCHAIN}} install exit-with --path . --force

  .manual
    .desc Builds the manual from its markdown files
    .cmd mdbook build
      .dir manual

  .pedantic
    .desc Runs pedantic linter
    .cmd cargo {{RUST_TOOLCHAIN}} clippy --all-targets -- -D warnings -W clippy::pedantic -W clippy::nursery

  .readme
    .desc Recreates README file
          Updates the README file taken from the documentation
          and then recalculates and updates code coverage stats.
    .cmd magg readme
    .task cov-badge

  .serve
    .desc Serves manual locally
    .cmd mdbook serve
      .dir manual

  .test
    .desc Runs tests in debug mode
    .cmd cargo {{RUST_TOOLCHAIN}} test

  .testn
    .desc Runs tests in debug mode using nextest
    .cmd cargo {{RUST_TOOLCHAIN}} nextest run

  .uninstall
    .desc Uninstalls previously installed binary
    .cmd cargo {{RUST_TOOLCHAIN}} uninstall exit-with
